NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/etat_db"

# JWT Secrets
JWT_ACCESS_SECRET=etat_access_secret_change_this_in_production
JWT_REFRESH_SECRET=etat_refresh_secret_change_this_in_production
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=E-TAT POLRI <noreply@e-tat.polri.go.id>
EMAIL_SEKRETARIAT=etatsiappulih@gmail.com

# CORS
FRONTEND_URL=http://localhost:3000

# App
APP_URL=http://localhost:5000
